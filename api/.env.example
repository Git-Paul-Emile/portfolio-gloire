# ---------------------------------------------------------------------------
# API de contact. Copier ce fichier en .env et completer.
# Le .env ne doit jamais etre versionne.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# Origines autorisees a appeler l'API, separees par une virgule.
# En production : https://www.gloire-mayombo.com
CORS_ORIGINS=http://localhost:5173

# --- Serveur d'envoi -------------------------------------------------------
# Gmail n'accepte plus le mot de passe du compte : il faut un mot de passe
# d'application, cree depuis la securite du compte Google.
# Port 587 avec SMTP_SECURE=false, ou port 465 avec SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mayombogloire29@gmail.com
SMTP_PASSWORD=mot-de-passe-application

# Expediteur affiche. Pour ne pas finir en indesirable, ce domaine doit avoir
# des enregistrements SPF et DKIM valides.
MAIL_FROM="Cabinet Gloire Mayombo <mayombogloire29@gmail.com>"

# Boite qui recoit les demandes du formulaire.
MAIL_TO=mayombogloire29@gmail.com

SITE_URL=https://www.gloire-mayombo.com

# --- Limitation de debit ---------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5
